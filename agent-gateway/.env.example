# Agent Gateway — variáveis de ambiente (SPEC-037 D11)
# Copie para .env e preencha. Nunca commite o arquivo .env com chaves reais.

# Bearer que o mobile envia em Authorization: Bearer <token>.
# O gateway valida e nunca devolve esse valor em resposta de erro.
AGENT_GATEWAY_TOKEN=seu-token-aqui

# Diretório onde execution.json e estado dos jobs são gravados.
GATEWAY_DATA_DIR=./data

# Chave(s) da NVIDIA NIM. Vem de variável de ambiente — nunca no bundle do app.
# Pode separar múltiplas chaves por vírgula para rotação/fallback (NimPool).
NIM_API_KEYS=nvapi-sua-chave-aqui

# Modelo usado pelo gateway. Altere aqui para trocar de modelo; não há seletor
# no mobile ainda — o modelo é definido no backend.
# Exemplos válidos no NVIDIA NIM:
#   nvidia/nemotron-3.5-bolt-e4b
#   nvidia/nemotron-3-super-120b-a12b
#   nvidia/nemotron-3.5-lightning-30b-a3b
NIM_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Base URL da NVIDIA NIM (não costurar mudar).
NIM_BASE_URL=https://integrate.api.nvidia.com

# Quantas vezes cada chave é tentada antes de ir para a próxima (fallback em 429/503).
NIM_MAX_ATTEMPTS_PER_KEY=3

# Timeout da chamada ao modelo, em ms.
NIM_TIMEOUT_MS=15000
